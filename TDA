<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>حاسبة تكلفة المشتريات</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f4;
            color: #333;
            margin: 0;
            padding: 20px;
            direction: rtl;
            text-align: right;
        }
        h1 {
            text-align: center;
            color: #4CAF50;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background-color: #fff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        th, td {
            padding: 12px;
            border: 1px solid #ddd;
            text-align: right;
        }
        th {
            background-color: #4CAF50;
            color: white;
        }
        input {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        input[type="number"], input[type="text"] {
            text-align: right;
        }
        .total-row {
            font-weight: bold;
            background-color: #f9f9f9;
        }
        button {
            background-color: #4CAF50;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin: 10px 0;
        }
        button:hover {
            background-color: #45a049;
        }
        #grand-total {
            font-size: 1.2em;
            margin-top: 20px;
            text-align: left;
        }
    </style>
</head>
<body>
    <h1>حاسبة تكلفة المشتريات</h1>
    <button id="add-row">إضافة سطر جديد</button>
    <button id="export-pdf">تصدير إلى PDF</button>
    <table id="shopping-table">
        <thead>
            <tr>
                <th>السلعة (اسم السلعة )</th>
                <th>الكمية </th>
                <th>سعر الوحدة </th>
                <th>المجموع </th>
                <th>ضريبة القيمة المضافة (%) (معدل الضريبة، اختياري، 19% فقط لـ نخالة، السلع الأخرى لا تحتوي على ضريبة)</th>
                <th>المجموع شامل الضريبة (المجموع مع الضريبة، اختياري)</th>
                <th>إجراء</th>
            </tr>
        </thead>
        <tbody>
            <!-- سطر افتراضي واحد -->
            <tr>
                <td><input type="text" class="article" placeholder="أدخل اسم السلعة"></td>
                <td><input type="number" class="quantity" min="0" value="1"></td>
                <td><input type="number" class="unit-price" min="0" step="0.01" value="0"></td>
                <td><input type="text" class="total" readonly></td>
                <td><input type="text" class="tva" readonly></td>
                <td><input type="text" class="total-ttc" readonly></td>
                <td><button class="remove-row">حذف</button></td>
            </tr>
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="3">المجموع الكلي:</td>
                <td id="grand-subtotal">0</td>
                <td id="grand-tva">0</td>
                <td id="grand-ttc">0</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
        const tableBody = document.querySelector('#shopping-table tbody');
        const addRowButton = document.getElementById('add-row');
        const exportPdfButton = document.getElementById('export-pdf');
        const grandSubtotal = document.getElementById('grand-subtotal');
        const grandTva = document.getElementById('grand-tva');
        const grandTtc = document.getElementById('grand-ttc');

        // دالة لحساب السطر
        function calculateRow(row) {
            const article = row.querySelector('.article').value.trim();
            const quantity = parseFloat(row.querySelector('.quantity').value) || 0;
            const unitPrice = parseFloat(row.querySelector('.unit-price').value) || 0;
            const total = quantity * unitPrice;
            let tvaRate = 0;
            if (article === 'نخالة') {
                tvaRate = 19;
            }
            const tvaAmount = (total * tvaRate) / 100;
            const totalTtc = total + tvaAmount;

            row.querySelector('.total').value = total.toFixed(2);
            row.querySelector('.tva').value = tvaRate.toFixed(0) + '%';
            row.querySelector('.total-ttc').value = totalTtc.toFixed(2);

            updateGrandTotals();
        }

        // دالة لتحديث المجاميع الكلية
        function updateGrandTotals() {
            let subTotal = 0;
            let tvaTotal = 0;
            let ttcTotal = 0;

            tableBody.querySelectorAll('tr').forEach(row => {
                subTotal += parseFloat(row.querySelector('.total').value) || 0;
                const tvaRate = parseFloat(row.querySelector('.tva').value) || 0;
                const rowTotal = parseFloat(row.querySelector('.total').value) || 0;
                tvaTotal += (rowTotal * tvaRate) / 100;
                ttcTotal += parseFloat(row.querySelector('.total-ttc').value) || 0;
            });

            grandSubtotal.textContent = subTotal.toFixed(2);
            grandTva.textContent = tvaTotal.toFixed(2);
            grandTtc.textContent = ttcTotal.toFixed(2);
        }

        // إضافة سطر جديد
        addRowButton.addEventListener('click', () => {
            const newRow = document.createElement('tr');
            newRow.innerHTML = `
                <td><input type="text" class="article" placeholder="أدخل اسم السلعة"></td>
                <td><input type="number" class="quantity" min="0" value="1"></td>
                <td><input type="number" class="unit-price" min="0" step="0.01" value="0"></td>
                <td><input type="text" class="total" readonly></td>
                <td><input type="text" class="tva" readonly></td>
                <td><input type="text" class="total-ttc" readonly></td>
                <td><button class="remove-row">حذف</button></td>
            `;
            tableBody.appendChild(newRow);
            attachRowListeners(newRow);
            calculateRow(newRow);
        });

        // إرفاق المستمعين للسطر
        function attachRowListeners(row) {
            row.querySelectorAll('.article, .quantity, .unit-price').forEach(input => {
                input.addEventListener('input', () => calculateRow(row));
            });
            row.querySelector('.remove-row').addEventListener('click', () => {
                row.remove();
                updateGrandTotals();
            });
        }

        // تهيئة السطر الأولي
        document.querySelectorAll('#shopping-table tbody tr').forEach(row => {
            attachRowListeners(row);
            calculateRow(row);
        });

        // تصدير إلى PDF
        exportPdfButton.addEventListener('click', () => {
            html2canvas(document.querySelector('#shopping-table')).then(canvas => {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('l', 'mm', 'a4'); // استخدام الوضع الأفقي ليتناسب مع الجدول العريض
                const pdfWidth = doc.internal.pageSize.getWidth();
                const pdfHeight = doc.internal.pageSize.getHeight();
                const imgData = canvas.toDataURL('image/png');
                const imgWidth = pdfWidth - 20; // هامش 10 مم من كل جانب
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                let position = 0;
                const topMargin = 10;
                const bottomMargin = 10;
                const leftMargin = 10;
                const usableHeight = pdfHeight - topMargin - bottomMargin;
                let heightLeft = imgHeight;

                doc.addImage(imgData, 'PNG', leftMargin, topMargin - position, imgWidth, imgHeight);
                position += usableHeight;
                heightLeft -= usableHeight;

                while (heightLeft > 0) {
                    doc.addPage();
                    doc.addImage(imgData, 'PNG', leftMargin, topMargin - position, imgWidth, imgHeight);
                    position += usableHeight;
                    heightLeft -= usableHeight;
                }

                doc.save('مشتريات.pdf');
            });
        });
    </script>
</body>
</html>
